{
  "$id": "search-recipes.input.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "search_recipes 输入",
  "type": "object",
  "properties": {
    "query": { "type": "string", "minLength": 1, "maxLength": 80, "description": "自然语言或关键词；可省略，仅用过滤器" },
    "meal_types": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["breakfast", "lunch", "dinner", "snack"] }
    },
    "include_ingredients": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/ingredient_ref" }
    },
    "exclude_ingredients": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/ingredient_ref" }
    },
    "dietary_constraints": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "exclude_allergens": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^[a-z_]+$", "maxLength": 32 }
    },
    "max_total_minutes": { "type": "integer", "minimum": 1, "maximum": 1200 },
    "equipment": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "可用厨具列表；菜谱所需厨具必须是它的子集" }
    },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "dish_role": {
      "enum": ["protein", "vegetable", "soup", "staple", "cold_dish", "mixed", "other"],
      "description": "按菜品在一餐里的角色过滤，用于配餐/整菜候选检索"
    },
    "limit": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/limit" },
    "cursor": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/cursor" }
  },
  "additionalProperties": false
}
