{
  "$id": "render-meal-plan-html.output.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "render_meal_plan_html 输出",
  "type": "object",
  "required": ["filename", "mime_type", "html", "artifact_path", "warnings"],
  "properties": {
    "filename": { "type": "string", "pattern": "^[a-z0-9-]+\\.html$" },
    "mime_type": { "const": "text/html; charset=utf-8" },
    "html": { "type": "string", "minLength": 1 },
    "artifact_path": { "type": "string", "minLength": 1 },
    "warnings": {
      "type": "array",
      "items": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/warning" }
    }
  },
  "additionalProperties": false
}
