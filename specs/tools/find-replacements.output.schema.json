{
  "$id": "find-replacements.output.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "find_replacements 输出",
  "type": "object",
  "required": ["base_recipe", "substitutions", "recipe_alternatives", "warnings"],
  "properties": {
    "base_recipe": {
      "type": "object",
      "required": ["recipe_id", "version", "name"],
      "properties": {
        "recipe_id": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/recipe_id" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "substitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["substitution_id", "version", "from_ingredient", "to_ingredient", "mode", "step_changes", "effects", "reason"],
        "properties": {
          "substitution_id": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "from_ingredient": { "type": "string" },
          "to_ingredient": { "type": ["string", "null"] },
          "mode": { "enum": ["replace", "omit"] },
          "ratio": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "step_changes": { "type": "array", "items": { "type": "string" } },
          "allergen_add": { "type": "array", "items": { "type": "string" } },
          "allergen_remove": { "type": "array", "items": { "type": "string" } },
          "effects": {
            "type": "object",
            "required": ["flavor", "texture", "time_delta_minutes"],
            "properties": {
              "flavor": { "type": "string" },
              "texture": { "type": "string" },
              "time_delta_minutes": { "type": "integer" }
            },
            "additionalProperties": false
          },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recipe_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipe_id", "version", "name", "total_minutes", "relation_type", "reason", "allergens"],
        "properties": {
          "recipe_id": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/recipe_id" },
          "version": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "total_minutes": { "type": "integer", "minimum": 0 },
          "relation_type": { "enum": ["variant_of", "alternative_to", "derived"] },
          "reason": { "type": "string" },
          "shared_ingredient_count": { "type": "integer", "minimum": 0 },
          "allergens": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/warning" }
    }
  },
  "additionalProperties": false
}
