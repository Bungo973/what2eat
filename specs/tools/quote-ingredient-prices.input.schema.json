{
  "$id": "quote-ingredient-prices.input.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "quote_ingredient_prices 输入",
  "type": "object",
  "required": ["region", "ingredients"],
  "properties": {
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "description": "地区，至少精确到城市，如 北京"
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["ingredient"],
        "properties": {
          "ingredient": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/ingredient_ref" },
          "quantity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "unit": { "enum": ["g", "kg", "ml", "l", "piece", "两", "斤", null] }
        },
        "additionalProperties": false
      }
    },
    "channel": {
      "type": ["string", "null"],
      "maxLength": 32,
      "description": "可选渠道；P0 支持 wholesale（批发）与 supermarket（超市零售估算）"
    },
    "max_age_hours": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 720,
      "description": "可选价格时效要求；超出时效的数据将降级并披露"
    }
  },
  "additionalProperties": false
}
