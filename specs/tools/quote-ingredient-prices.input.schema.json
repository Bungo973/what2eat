{
  "$id": "quote-ingredient-prices.input.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "quote_ingredient_prices 输入",
  "type": "object",
  "required": ["ingredients"],
  "properties": {
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "description": "可选地区；提供城市时优先匹配所在省份，未提供时使用全国参考价"
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["ingredient"],
        "properties": {
          "ingredient": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/ingredient_ref" },
          "quantity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "unit": { "enum": ["g", "kg", "ml", "l", "piece", "两", "斤", null] }
        },
        "additionalProperties": false
      }
    },
    "channel": {
      "type": ["string", "null"],
      "maxLength": 32,
      "description": "可选渠道；P0 支持 wholesale（批发）与 supermarket（超市零售估算）"
    },
    "max_age_hours": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 720,
      "description": "可选价格时效要求；超出时效的数据将降级并披露"
    },
    "allow_national_fallback": {
      "type": "boolean",
      "default": true,
      "description": "省级市场无报价时是否允许全国或跨地区维护者基准参考；false 时所有非省级命中项进入 unmatched"
    }
  },
  "additionalProperties": false
}
