{
  "$id": "https://what2eat.dev/schemas/common.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "共享类型定义",
  "description": "what2eat 工具契约的共享 $defs，各工具 schema 通过相对 $ref 引用",
  "$defs": {
    "price_range": {
      "type": "object",
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "quantity_unit": {
      "type": "object",
      "required": ["quantity", "unit"],
      "properties": {
        "quantity": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"], "enum": [null, "g", "kg", "ml", "l", "piece", "两", "斤"] }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "description": "警告指向对象，如 ingredient_id / recipe_id" }
      },
      "additionalProperties": false
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "price_data_type": { "enum": ["realtime", "cached", "benchmark"] },
    "ingredient_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "标准食材 ID；或尚未标准化的食材名称（服务端负责解析并披露）"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
    "cursor": {
      "type": "string",
      "maxLength": 256,
      "description": "不透明分页游标；由上一次响应的 next_cursor 提供"
    },
    "iso_datetime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" }
  }
}
