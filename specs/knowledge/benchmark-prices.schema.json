{
  "$id": "benchmark-prices.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "地区基准价格契约",
  "description": "knowledge/prices/<region>-benchmark.md 的 YAML frontmatter（PRD §10.2 benchmark provider）。",
  "type": "object",
  "required": ["schema_version", "region", "currency", "updated_at", "basis", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "region": { "type": "string", "minLength": 2, "maxLength": 32, "description": "规范城市名，如 北京" },
    "currency": { "const": "CNY" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "basis": {
      "enum": ["wholesale", "retail_estimate"],
      "description": "价格口径；retail_estimate 表示维护者基于批发价加估算系数得出，须在 notes 说明"
    },
    "notes": { "type": "string", "maxLength": 500 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ingredient_id", "unit", "price_range", "source", "recorded_at"],
        "properties": {
          "ingredient_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40 },
          "unit": { "enum": ["g", "kg", "ml", "l", "piece", "斤", "两"] },
          "price_range": {
            "type": "object",
            "required": ["low", "high"],
            "properties": {
              "low": { "type": "number", "exclusiveMinimum": 0 },
              "high": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "如：北京新发地 2026-08-23 均价 ×1.6 零售估算"
          },
          "recorded_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
