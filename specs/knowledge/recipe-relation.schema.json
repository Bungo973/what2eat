{
  "$id": "recipe-relation.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "菜谱关系契约",
  "type": "object",
  "required": [
    "schema_version",
    "relation_id",
    "version",
    "status",
    "type",
    "source_recipe_id",
    "target_recipe_id",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "relation_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 120 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published", "archived"] },
    "type": { "enum": ["variant_of", "alternative_to", "pairs_with", "uses_leftover_from"] },
    "source_recipe_id": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/recipe_id" },
    "target_recipe_id": { "$ref": "https://what2eat.dev/schemas/common.schema.json#/$defs/recipe_id" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
    "conditions": {
      "type": "object",
      "properties": {
        "meal_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["breakfast", "lunch", "dinner", "snack"] }
        }
      },
      "additionalProperties": false
    },
    "published_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "additionalProperties": false
}
