{
  "$id": "ingredient-catalog.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "标准食材目录契约",
  "description": "knowledge/menu/ingredients/ 目录文档的 YAML frontmatter。当前为单文档目录。",
  "type": "object",
  "required": ["schema_version", "catalog_version", "ingredients"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "canonical_name",
          "aliases",
          "category",
          "default_purchase_unit",
          "conversions",
          "allergen_tags",
          "price_query_terms"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40 },
          "canonical_name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "category": {
            "enum": [
              "vegetable",
              "fruit",
              "meat",
              "egg_dairy",
              "aquatic",
              "grain",
              "oil_condiment",
              "spice",
              "other"
            ]
          },
          "default_purchase_unit": {
            "enum": ["g", "kg", "ml", "l", "piece", "斤", "两"]
          },
          "conversions": {
            "type": "array",
            "description": "该食材可选单位到基准单位的换算因子；基准单位为 g/ml/piece 之一",
            "items": {
              "type": "object",
              "required": ["from_unit", "to_unit", "factor"],
              "properties": {
                "from_unit": { "type": "string", "enum": ["g", "kg", "ml", "l", "piece", "斤", "两"] },
                "to_unit": { "type": "string", "enum": ["g", "ml", "piece"] },
                "factor": { "type": "number", "exclusiveMinimum": 0 },
                "approximate": { "type": "boolean", "default": false, "description": "近似换算（如 个→g），汇总时必须产生警告" }
              },
              "additionalProperties": false
            }
          },
          "allergen_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z_]+$", "maxLength": 32 }
          },
          "price_query_terms": {
            "type": "array",
            "description": "按价格源列出查询词与规格偏好",
            "items": {
              "type": "object",
              "required": ["source", "terms"],
              "properties": {
                "source": { "enum": ["xinfadi", "pfsc", "jiangnan"] },
                "terms": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1, "maxLength": 40 }
                },
                "external_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "该价格源的稳定品种 ID；仅在来源提供 ID 查询时使用"
                },
                "preferred_specs": {
                  "type": "array",
                  "description": "多规格商品的优先规格关键词，如 瘦/净/散",
                  "items": { "type": "string", "maxLength": 20 }
                },
                "unit_hint": {
                  "type": "string",
                  "enum": ["斤", "公斤"],
                  "description": "该源报价单位提示；新发地为斤，江南为公斤"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
